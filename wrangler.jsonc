{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  // Access secrets ride in the URL path, so request logs and traces stay off. Errors still log.
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": false } },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "4207", "simple": { "limit": 10, "period": 60 } }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
